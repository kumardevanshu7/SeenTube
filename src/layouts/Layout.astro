---
import "@/styles/globals.css";
import Navbar, { BottomNav } from "@/components/Navbar";
import { Toaster } from "sonner";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  showNav?: boolean;
  user?: {
    id: string;
    name: string;
    email: string;
    image?: string | null;
  } | null;
}

const {
  title = "SeenTube",
  description = "Your shared YouTube collection",
  showNav = true,
  user = null,
} = Astro.props;
const isProduction = import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="application-name" content="SeenTube" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="SeenTube" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title} — SeenTube</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <ClientRouter />
    <script is:inline>
      window.addEventListener("vite:preloadError", (event) => {
        event.preventDefault();
        const key = "seentube:vite-preload-reload";
        const lastReload = Number(sessionStorage.getItem(key) || 0);
        if (Date.now() - lastReload < 10000) return;
        sessionStorage.setItem(key, String(Date.now()));
        window.location.reload();
      });
    </script>
    <script define:vars={{ isProduction }}>
      if (isProduction && "serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js", { scope: "/" })
            .then((registration) => registration.update())
            .catch((error) => console.error("Service worker registration failed:", error));
        }, { once: true });
      }
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    {
      showNav && (
        <Navbar
          client:load
          transition:persist="navbar"
        />
      )
    }
    <main class={showNav ? "pt-20 pb-20 lg:pb-0" : ""}>
      <slot />
    </main>
    {
      showNav && (
        <BottomNav
          client:load
          transition:persist="bottom-nav"
        />
      )
    }
    <Toaster
      client:load
      transition:persist="toaster"
      position="bottom-right"
      theme="light"
      expand
      toastOptions={{
        classNames: {
          toast: "!rounded-lg !border !border-border !bg-white !shadow-none !font-sans !text-sm",
          title: "!text-foreground !font-medium",
          description: "!text-muted-foreground",
          success: "!border-border [&_[data-icon]]:!text-primary",
          error: "!border-[hsl(11,81%,90%)] !bg-[hsl(11,81%,97%)] [&_[data-icon]]:!text-destructive",
          closeButton: "!bg-white !border-border !text-foreground",
        },
      }}
    />
  </body>
</html>
