---
import "@/styles/globals.css";
import Navbar, { BottomNav } from "@/components/Navbar";
import { Toaster } from "sonner";

interface Props {
  title?: string;
  description?: string;
  showNav?: boolean;
  user?: {
    id: string;
    name: string;
    email: string;
    image?: string | null;
  } | null;
}

const {
  title = "SeenTube",
  description = "Your shared YouTube collection",
  showNav = true,
  user = null,
} = Astro.props;
const isProduction = import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="application-name" content="SeenTube" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="SeenTube" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title} — SeenTube</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      window.addEventListener("vite:preloadError", (event) => {
        event.preventDefault();
        const key = "seentube:vite-preload-reload";
        const lastReload = Number(sessionStorage.getItem(key) || 0);
        if (Date.now() - lastReload < 10000) return;
        sessionStorage.setItem(key, String(Date.now()));
        window.location.reload();
      });
    </script>
    <script define:vars={{ isProduction }}>
      if (isProduction && "serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js", { scope: "/" })
            .then((registration) => registration.update())
            .catch((error) => console.error("Service worker registration failed:", error));
        }, { once: true });
      }
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    {
      showNav && (
        <Navbar client:load />
      )
    }
    <main class={showNav ? "pt-20 pb-20 lg:pb-0" : ""}>
      <slot />
    </main>
    {
      showNav && (
        <BottomNav client:load />
      )
    }
    <Toaster
      client:only="react"
      position="bottom-right"
      theme="light"
      richColors={false}
      closeButton
      visibleToasts={4}
      gap={10}
      offset={{ bottom: "5.5rem", right: "1rem" }}
      mobileOffset={{ bottom: "5.5rem", right: "1rem" }}
      toastOptions={{
        className: "seentube-toast",
        classNames: {
          toast: "seentube-toast group",
          title: "seentube-toast-title",
          description: "seentube-toast-description",
          success: "seentube-toast-success",
          error: "seentube-toast-error",
          info: "seentube-toast-info",
          closeButton: "seentube-toast-close",
        },
      }}
    />
  </body>
</html>
