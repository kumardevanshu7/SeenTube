---
import Layout from "@/layouts/Layout.astro";
import LegalPageShell from "@/components/LegalPageShell.astro";
---

<Layout
  title="About Arigato Labs"
  description="SeenTube is a product of Arigato Labs, founded by Kumar Devanshu in 2026."
>
  <LegalPageShell
    title="About Arigato Labs"
    lead="SeenTube is a product of Arigato Labs — built for clear collections, trusted sharing, and calm learning paths."
  >
    <section class="space-y-3">
      <h2>Product</h2>
      <p>
        <strong>SeenTube</strong> is a product of <strong>Arigato Labs</strong>. It helps you save YouTube videos,
        track watch progress, connect with people you trust, and build ordered learning roadmaps.
      </p>
    </section>

    <section class="space-y-3">
      <h2>Founder</h2>
      <p>
        Built by <strong>Kumar Devanshu</strong>, founder of Arigato Labs (2026).
      </p>
    </section>

    <section class="space-y-3">
      <h2>Mission</h2>
      <p>
        We build sleek, modern, high-performance tools that help people get things done with clarity and calm.
        Software should feel fast, natural, and carefully designed.
      </p>
    </section>

    <section class="space-y-3">
      <h2>Get in touch</h2>
      <p>
        Questions about SeenTube or Arigato Labs?
        <a href="/contact">Contact us</a>
        or email
        <a href="mailto:kumardevanshu3001@gmail.com">kumardevanshu3001@gmail.com</a>.
      </p>
    </section>

    <p class="!text-foreground pt-2 text-sm font-medium">
      Copyright © 2026 Arigato Labs. All Rights Reserved.
    </p>
  </LegalPageShell>
</Layout>
