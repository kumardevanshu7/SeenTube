---
import Layout from "@/layouts/Layout.astro";
import AddVideoForm from "@/components/AddVideoForm";
---

<Layout
  title="Add Video"
  description="Add a YouTube video to your shared collection"
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-8 space-y-8">
    <!-- Header -->
    <div class="animate-fade-in">
      <a
        href="/videos"
        class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
        Back to collection
      </a>

      <h1 class="font-display text-3xl font-bold">
        Add a <span class="gradient-text">Video</span>
      </h1>
      <p class="text-muted-foreground mt-1">
        Paste a YouTube link — title and thumbnail are fetched automatically.
      </p>
    </div>

    <!-- Form -->
    <div class="animate-fade-in" style="animation-delay: 100ms">
      <AddVideoForm client:load />
    </div>
  </div>
</Layout>
