---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Explore Arigato Labs" description="Meet Arigato Labs, the company behind SeenTube." showSiteFooter={false}>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-20">
    <header class="mx-auto max-w-3xl text-center animate-fade-in">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary">Behind SeenTube</p>
      <h1 class="mt-3 text-4xl font-bold tracking-[-0.04em] sm:text-6xl">Our Company</h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-muted-foreground sm:text-lg">
        Building modern software that feels natural, fast, and distinctly beautiful.
      </p>
    </header>

    <section class="py-10 text-center sm:py-14">
      <img src="/arigato-labs-logo.png" alt="Arigato Labs" class="mx-auto w-full max-w-[650px] object-contain" />
    </section>

    <section class="mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#bcebc9] bg-[#f1fcf4] px-3 py-1.5 text-xs font-semibold text-[#267a3c]">
        <span class="flex h-4 w-4 items-center justify-center rounded-full bg-[#267a3c] text-[10px] text-white">✓</span>
        Verified Founder
      </div>
      <p class="mt-6 text-xl font-medium leading-8 sm:text-2xl">
        <strong>SeenTube</strong> is proudly developed by <strong>Kumar Devanshu</strong>, the founder of
        <strong> Arigato Labs</strong> in 2026.
      </p>
      <p class="mt-6 text-base leading-8 text-muted-foreground">
        Our mission is to build sleek, modern, and high-performance tools that empower individuals and teams
        to achieve their goals with elegance and ease. We believe software should feel natural, fast, and
        distinctly beautiful.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/login" class="inline-flex h-12 items-center justify-center rounded-lg bg-primary px-6 text-sm font-semibold text-white hover:bg-[#e00b41]">
          Open SeenTube <span class="ml-2" aria-hidden="true">→</span>
        </a>
        <a href="/contact" class="inline-flex h-12 items-center justify-center rounded-lg border border-foreground px-6 text-sm font-medium hover:bg-secondary">
          Contact
        </a>
      </div>
    </section>

    <footer class="mt-16 border-t border-border pt-10 text-center sm:mt-24 sm:pt-12">
      <h2 class="text-sm font-bold tracking-[0.14em]">ARIGATO LABS</h2>
      <p class="mt-4 text-sm font-medium">Copyright © 2026 Arigato Labs. All Rights Reserved.</p>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-muted-foreground">
        <strong class="text-foreground">SeenTube</strong> is a product of Arigato Labs, founded by Kumar Devanshu.
        Brand name and logos may not be reused outside Arigato Labs apps without permission.
      </p>
      <p class="mt-4 text-xs text-muted-foreground sm:text-sm">
        See <a class="font-medium text-foreground hover:text-primary" href="/privacy">Privacy</a>,
        <a class="font-medium text-foreground hover:text-primary" href="/terms">Terms</a>, and
        <a class="font-medium text-foreground hover:text-primary" href="/disclaimer">Disclaimer</a> in this app.
        Contact: <a class="font-medium text-primary hover:underline" href="mailto:kumardevanshu3001@gmail.com">kumardevanshu3001@gmail.com</a>
      </p>
      <nav class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm" aria-label="Company pages">
        <a href="/about" class="font-medium text-foreground hover:text-primary">About</a>
        <span class="text-border" aria-hidden="true">·</span>
        <a href="/privacy" class="font-medium text-foreground hover:text-primary">Privacy</a>
        <span class="text-border" aria-hidden="true">·</span>
        <a href="/terms" class="font-medium text-foreground hover:text-primary">Terms</a>
        <span class="text-border" aria-hidden="true">·</span>
        <a href="/disclaimer" class="font-medium text-foreground hover:text-primary">Disclaimer</a>
        <span class="text-border" aria-hidden="true">·</span>
        <a href="/contact" class="font-medium text-foreground hover:text-primary">Contact</a>
      </nav>
    </footer>
  </div>
</Layout>
