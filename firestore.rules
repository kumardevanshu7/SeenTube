rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasAcceptedConnection(otherUserId) {
      return isSignedIn()
        && otherUserId is string
        && otherUserId != request.auth.uid
        && (
          (
            exists(/databases/$(database)/documents/connections/$(request.auth.uid + "__" + otherUserId))
            && get(/databases/$(database)/documents/connections/$(request.auth.uid + "__" + otherUserId)).data.status == "accepted"
          )
          || (
            exists(/databases/$(database)/documents/connections/$(otherUserId + "__" + request.auth.uid))
            && get(/databases/$(database)/documents/connections/$(otherUserId + "__" + request.auth.uid)).data.status == "accepted"
          )
        );
    }

    // =====================================================
    // USER PROFILES
    // =====================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isCurrentUser(userId)
        && request.resource.data.id == request.auth.uid;
      allow delete: if false;
    }

    // =====================================================
    // UNIQUE USERNAMES
    // =====================================================
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // =====================================================
    // CONNECTION REQUESTS
    // =====================================================
    match /connections/{connectionId} {
      // App separately queries connections where the current
      // user is the requester and where they are the recipient.
      allow read: if isSignedIn()
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.recipientId == request.auth.uid
        );

      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.requesterId in request.resource.data.participants
        && request.resource.data.recipientId in request.resource.data.participants
        && request.resource.data.status == "pending"
        && connectionId == request.resource.data.participants[0] + "__" + request.resource.data.participants[1];

      // Only the request recipient can accept it.
      allow update: if isSignedIn()
        && resource.data.status == "pending"
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.status == "accepted"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]);

      // Requester can cancel, recipient can decline,
      // and either participant can disconnect.
      allow delete: if isSignedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
    }

    // =====================================================
    // YOUTUBE VIDEOS
    // =====================================================
    match /videos/{videoDocumentId} {
      // Owner can read all their own videos.
      // Connections can only read public videos.
      allow read: if isSignedIn()
        && (
          resource.data.addedBy == request.auth.uid
          || (
            resource.data.visibility == "public"
            && hasAcceptedConnection(resource.data.addedBy)
          )
        );

      allow create: if isSignedIn()
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.videoId is string
        && request.resource.data.visibility in ["public", "private"];

      allow update: if isSignedIn()
        && resource.data.addedBy == request.auth.uid
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.videoId == resource.data.videoId;

      // Videos are deleted through the password-protected
      // server API. Firebase Admin bypasses client rules.
      allow delete: if false;
    }

    // =====================================================
    // VIDEO WATCH STATUSES
    // =====================================================
    match /videoStatuses/{statusId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.videoId is string
        && request.resource.data.status in ["pending", "partially_watched", "watched"];

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.videoId == resource.data.videoId
        && request.resource.data.status in ["pending", "partially_watched", "watched"];

      // Associated status records are deleted through
      // the password-protected server API.
      allow delete: if false;
    }

    // =====================================================
    // MIND ROADMAPS
    // =====================================================
    match /roadmaps/{roadmapId} {
      // Owner can read all their own roadmaps.
      // Connections can only read public roadmaps.
      allow read: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || (
            resource.data.visibility == "public"
            && hasAcceptedConnection(resource.data.ownerId)
          )
        );

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.steps is list
        && request.resource.data.visibility in ["public", "private"];

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.title is string
        && request.resource.data.steps is list
        && request.resource.data.visibility in ["public", "private"];

      // Roadmaps are deleted through the password-protected
      // server API.
      allow delete: if false;
    }

    // =====================================================
    // ADMIN-ONLY DELETION SECURITY
    // =====================================================
    // Password and security-answer hashes must never be
    // accessible through the browser Firebase SDK.
    match /deletionCredentials/{userId} {
      allow read, write: if false;
    }

    // =====================================================
    // DENY UNKNOWN COLLECTIONS
    // =====================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
