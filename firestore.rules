rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function connectionDocId(a, b) {
      return a + "__" + b;
    }

    function connectionExists(a, b) {
      return exists(/databases/$(database)/documents/connections/$(connectionDocId(a, b)));
    }

    function connectionStatus(a, b) {
      return get(/databases/$(database)/documents/connections/$(connectionDocId(a, b))).data.status;
    }

    function hasAcceptedConnection(otherUserId) {
      return isSignedIn()
        && otherUserId is string
        && otherUserId != request.auth.uid
        && (
          (connectionExists(request.auth.uid, otherUserId) && connectionStatus(request.auth.uid, otherUserId) == "accepted")
          || (connectionExists(otherUserId, request.auth.uid) && connectionStatus(otherUserId, request.auth.uid) == "accepted")
        );
    }

    function hasAnyConnection(otherUserId) {
      return isSignedIn()
        && otherUserId is string
        && otherUserId != request.auth.uid
        && (
          (connectionExists(request.auth.uid, otherUserId)
            && connectionStatus(request.auth.uid, otherUserId) in ["pending", "accepted"])
          || (connectionExists(otherUserId, request.auth.uid)
            && connectionStatus(otherUserId, request.auth.uid) in ["pending", "accepted"])
        );
    }

    // Own deterministic video ids look like "{uid}_{youtubeId}"
    function isOwnVideoDocId(videoDocumentId) {
      return videoDocumentId.matches("^" + request.auth.uid + "_.*");
    }

    function isOwnStatusDocId(statusId) {
      return statusId.matches(".*_" + request.auth.uid + "$")
        || statusId.matches("^" + request.auth.uid + "_.*");
    }

    // =====================================================
    // USER PROFILES
    // =====================================================
    match /users/{userId} {
      // No open list of all users/emails. Direct gets for self or
      // people you have a pending/accepted connection with.
      allow get: if isSignedIn()
        && (
          isCurrentUser(userId)
          || hasAnyConnection(userId)
        );
      allow list: if false;

      allow create, update: if isCurrentUser(userId)
        && (
          !("id" in request.resource.data)
          || request.resource.data.id == request.auth.uid
        );
      allow delete: if false;
    }

    // =====================================================
    // UNIQUE USERNAMES
    // =====================================================
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // =====================================================
    // CONNECTION REQUESTS
    // =====================================================
    match /connections/{connectionId} {
      allow read: if isSignedIn()
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.recipientId == request.auth.uid
        );

      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.requesterId in request.resource.data.participants
        && request.resource.data.recipientId in request.resource.data.participants
        && request.resource.data.status == "pending"
        && connectionId == request.resource.data.participants[0] + "__" + request.resource.data.participants[1];

      allow update: if isSignedIn()
        && resource.data.status == "pending"
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.status == "accepted"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]);

      allow delete: if isSignedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
    }

    // =====================================================
    // YOUTUBE VIDEOS
    // =====================================================
    match /videos/{videoDocumentId} {
      // Missing docs: only allow existence checks on YOUR destination ids
      // (import flow). Blocks probing other users' private video ids.
      allow read: if isSignedIn()
        && (
          (resource == null && isOwnVideoDocId(videoDocumentId))
          || (
            resource != null
            && (
              resource.data.addedBy == request.auth.uid
              || (
                resource.data.visibility == "public"
                && hasAcceptedConnection(resource.data.addedBy)
              )
            )
          )
        );

      allow create: if isSignedIn()
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.videoId is string
        && request.resource.data.visibility in ["public", "private"];

      allow update: if isSignedIn()
        && resource.data.addedBy == request.auth.uid
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.videoId == resource.data.videoId;

      allow delete: if false;
    }

    // =====================================================
    // VIDEO WATCH STATUSES
    // =====================================================
    match /videoStatuses/{statusId} {
      allow read: if isSignedIn()
        && (
          (resource == null && isOwnStatusDocId(statusId))
          || (resource != null && resource.data.userId == request.auth.uid)
        );

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.videoId is string
        && request.resource.data.status in ["pending", "partially_watched", "watched"];

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.videoId == resource.data.videoId
        && request.resource.data.status in ["pending", "partially_watched", "watched"]
        && (
          resource.data.status != "watched"
          || request.resource.data.status == "watched"
        );

      allow delete: if false;
    }

    // =====================================================
    // MIND ROADMAPS
    // =====================================================
    match /roadmaps/{roadmapId} {
      // No resource==null oracle — creates use new ids; copies don't pre-get destination.
      allow read: if isSignedIn()
        && resource != null
        && (
          resource.data.ownerId == request.auth.uid
          || (
            resource.data.visibility == "public"
            && hasAcceptedConnection(resource.data.ownerId)
          )
        );

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.steps is list
        && request.resource.data.visibility in ["public", "private"];

      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.title is string
        && request.resource.data.steps is list
        && request.resource.data.visibility in ["public", "private"];

      allow delete: if false;
    }

    // =====================================================
    // ADMIN-ONLY DELETION SECURITY
    // =====================================================
    match /deletionCredentials/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
