# SeenTube environment variables
# Copy to .env for local development. Never commit real values.
# Add the same keys in Vercel → Project Settings → Environment Variables.

# Firebase Console → Project Settings → General → Your apps → Web app
# PUBLIC_ variables are bundled into the browser by Astro. Firebase Web
# configuration identifies the project but is not a server-side secret.
PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Optional canonical deployment URL (currently not required by application code)
# PUBLIC_APP_URL=https://your-project.vercel.app

# Contact form → kumardevanshu3001@gmail.com (Web3Forms)
# Create a key at https://web3forms.com with that Gmail, then paste it here / in Vercel.
PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# Server-only Firebase Admin configuration for protected deletion APIs.
# Each user creates a personal deletion password in Settings; no global password env is used.
# Firebase Console → Project Settings → Service accounts → Generate new private key
# Store these only in local .env / Vercel encrypted environment variables.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"
